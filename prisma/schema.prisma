generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  foods     Food[]
  foodLogs   FoodLog[]
  weightLogs WeightLog[]
  goal         Goal?
  height       Float?   // cm
  age          Int?
  gender       String?  // male/female
  activity     String?  // sedentary/light/moderate/active/very_active
  targetWeight Float?   // kg desired
  locale       String    @default("vi")
  shareExercise Boolean   @default(false)
  shareFinance  Boolean   @default(false)
  shareWeight   Boolean   @default(false)
  familyMembers FamilyMember[]
  exercises    ExerciseLog[]
  expenses     Expense[]
  budget       Budget?
  pushSubs     PushSubscription[]
}

model Food {
  id          String    @id @default(cuid())
  name        String
  calories    Float
  protein     Float     @default(0)
  carbs       Float     @default(0)
  fat         Float     @default(0)
  servingSize String?
  source      String?   // data source: 'VFCT2007', 'Wikipedia', 'Nutrihome', 'estimate'
  isCustom    Boolean   @default(false)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodLogs    FoodLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([name])
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  quantity  Float    @default(1)
  mealType  String?
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@unique([userId, date])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories Int      @default(2000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Family {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  members   FamilyMember[]
  createdAt DateTime @default(now())
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  @@unique([familyId, userId])
}

model ExerciseLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  duration  Int
  calories  Int
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float    @default(2000000)
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
